# npm 11 起会对「自己不认识的配置键」发警告：
#   npm warn Unknown project config "electron_mirror"
# 因为 electron_mirror 是给 @electron/get（装 Electron 时下载二进制的脚本）读的，
# 不归 npm 管；npm 以前会悄悄转成 npm_config_electron_mirror 环境变量传下去，
# 但从 v11.2.0 开始警告、未来大版本可能不再传递。
#
# 所以这里不再写镜像地址，改成两条正路：
#   ① 打安装包（electron-builder）：见 electron-builder.yml 的 electronDownload.mirror
#   ② 重装 Electron（npm i electron）前，临时设环境变量：
#        PowerShell:  $env:ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/"
#        CMD:         set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
#      想永久生效就 setx ELECTRON_MIRROR "https://npmmirror.com/mirrors/electron/"

fund=false
audit=false
